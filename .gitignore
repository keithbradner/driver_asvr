# Build outputs
/bin/win32/
/bin/win64/
/bin/linux64/
/driver_asvr/bin/
/asvr_monitor/bin/
/build/
# Hashed icon copies SteamVR writes into a dev-registered resources folder
/resources/icons/*.*.png
/dist/
**/objs/
*.vcxproj.user
*.aps

# Local diagnostics
SteamVR-*.txt

# Vendor: only the pieces the build and packaging need are tracked
/vendor/*
!/vendor/openvr
/vendor/openvr/*
!/vendor/openvr/headers
!/vendor/openvr/docs
!/vendor/openvr/lib
/vendor/openvr/lib/*
!/vendor/openvr/lib/win64
!/vendor/openvr/lib/linux64
!/vendor/openvr/bin
/vendor/openvr/bin/*
!/vendor/openvr/bin/win64
!/vendor/openvr/bin/linux64
/vendor/openvr/bin/win64/*.pdb
!/vendor/openvr/LICENSE
!/vendor/glm
/vendor/glm/*
!/vendor/glm/glm
!/vendor/glm/copying.txt
!/vendor/imgui
!/vendor/glfw
/vendor/glfw/*
!/vendor/glfw/CMake
!/vendor/glfw/include
!/vendor/glfw/src
!/vendor/glfw/CMakeLists.txt
!/vendor/glfw/LICENSE.md
!/vendor/json
/vendor/json/*
!/vendor/json/single_include
!/vendor/json/LICENSE.MIT
!/vendor/stb
!/vendor/volk
!/vendor/vulkan
