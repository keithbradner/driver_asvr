{
  "jsonid": "input_binding",
  "controller_type": "asvr_controller",
  "name": "ASVR controller legacy bindings",
  "description": "Bindings for legacy (pre-SteamVR Input) applications",
  "category": "steamvr_input",
  "bindings": {
    "/actions/legacy": {
      "sources": [
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": { "output": "/actions/legacy/in/right_axis1_value" },
            "click": { "output": "/actions/legacy/in/right_axis1_press" }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/legacy/in/right_grip_press" }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": { "output": "/actions/legacy/in/right_axis0_value" }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/legacy/in/right_a_press" }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/legacy/in/right_applicationmenu_press" }
          }
        },
        {
          "path": "/user/hand/right/input/system",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/legacy/in/right_system_press" }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": { "output": "/actions/legacy/in/left_axis1_value" },
            "click": { "output": "/actions/legacy/in/left_axis1_press" }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/legacy/in/left_grip_press" }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/legacy/in/left_a_press" }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/legacy/in/left_applicationmenu_press" }
          }
        },
        {
          "path": "/user/hand/left/input/system",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/legacy/in/left_system_press" }
          }
        }
      ]
    }
  }
}
